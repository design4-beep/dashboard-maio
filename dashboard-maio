<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Notion - Performance</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #191919; /* Cor exata de fundo do Notion Dark */
        }
        .notion-card {
            background-color: #202020;
            border: 1px solid #2a2a2a;
        }
    </style>
</head>
<body class="p-4 md:p-6 text-[#FFFFFFDE]">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-[#2a2a2a] pb-4">
            <div>
                <h1 class="text-xl font-bold text-white tracking-tight">Dashboard de Performance Comercial</h1>
                <p class="text-xs text-gray-400 mt-1">Dados Consolidados e Atualizados — Integração Completa</p>
            </div>
            <div class="mt-2 sm:mt-0">
                <span class="bg-[#2e2e2e] text-gray-300 text-[11px] font-medium px-2.5 py-1 rounded border border-[#3e3e3e]">Maio 2026</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="notion-card p-5 rounded-xl shadow-lg">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Vendas Realizadas (R$)</p>
                <p class="text-2xl font-bold mt-2 text-white font-mono">R$ 51.520,00</p>
                <p class="text-[11px] text-emerald-400 mt-2 flex items-center">↑ Valor Bruto Consolidado</p>
            </div>
            <div class="notion-card p-5 rounded-xl shadow-lg">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Vendas Realizadas (Un.)</p>
                <p class="text-2xl font-bold mt-2 text-blue-400 font-mono">67 pedidos</p>
                <p class="text-[11px] text-gray-400 mt-2">Transações aprovadas</p>
            </div>
            <div class="notion-card p-5 rounded-xl shadow-lg">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Visitas na Loja</p>
                <p class="text-2xl font-bold mt-2 text-purple-400 font-mono">4.254</p>
                <p class="text-[11px] text-gray-500 mt-2">Tráfego total verificado</p>
            </div>
            <div class="notion-card p-5 rounded-xl shadow-lg">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Conversão da Loja Virtual</p>
                <p class="text-2xl font-bold mt-2 text-white font-mono">1,57%</p>
                <p class="text-[11px] text-emerald-400 mt-2">Dentro da média de mercado</p>
            </div>
        </div>

        <div class="notion-card p-5 rounded-xl shadow-lg">
            <h2 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Etapas do Funil de Conversão</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                <div class="bg-[#191919] p-4 rounded-lg border border-[#2a2a2a] text-center">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Visitantes Únicos</p>
                    <p class="text-lg font-bold text-white mt-1 font-mono">3.537</p>
                </div>
                <div class="bg-[#191919] p-4 rounded-lg border border-[#2a2a2a] text-center">
                    <p class="text-[10px] font-bold text-blue-400 uppercase tracking-wider">Leads Gerados</p>
                    <p class="text-lg font-bold text-blue-400 mt-1 font-mono">23</p>
                </div>
                <div class="bg-[#191919] p-4 rounded-lg border border-[#2a2a2a] text-center">
                    <p class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Oportunidades</p>
                    <p class="text-lg font-bold text-amber-400 mt-1 font-mono">3</p>
                </div>
                <div class="bg-[#191919] p-4 rounded-lg border border-[#2a2a2a] text-center">
                    <p class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider">Vendas Finais</p>
                    <p class="text-lg font-bold text-emerald-400 mt-1 font-mono">3</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <div class="notion-card p-5 rounded-xl shadow-lg lg:col-span-1">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Produtos Mais Vistos</h3>
                <div class="space-y-3 text-xs text-gray-300">
                    <div class="p-2.5 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between items-center">
                        <span>Camisa Scrub Feminina Harmonia</span>
                        <span class="font-mono text-gray-400 font-bold">198</span>
                    </div>
                    <div class="p-2.5 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between items-center">
                        <span>Camisa Scrub Masculino Bem-Estar</span>
                        <span class="font-mono text-gray-400 font-bold">137</span>
                    </div>
                    <div class="p-2.5 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between items-center">
                        <span>Camisa Scrub Feminino Bem-Estar</span>
                        <span class="font-mono text-gray-400 font-bold">125</span>
                    </div>
                    <div class="p-2.5 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between items-center">
                        <span>Calça Scrub Feminina Conforto Flex</span>
                        <span class="font-mono text-gray-400 font-bold">112</span>
                    </div>
                </div>
            </div>

            <div class="notion-card p-5 rounded-xl shadow-lg lg:col-span-2">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Evolução do Tráfego no Período</h3>
                <div class="h-48">
                    <canvas id="notionChart"></canvas>
                </div>
            </div>
        </div>

        <div class="notion-card p-5 rounded-xl shadow-lg">
            <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Métricas de Campanhas de E-mail</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="bg-[#191919] text-gray-400 uppercase text-[10px] tracking-wider border-b border-[#2a2a2a]">
                            <th class="py-3 px-4 font-semibold">Campanha</th>
                            <th class="py-3 px-4 font-semibold">Cliques Únicos</th>
                            <th class="py-3 px-4 font-semibold text-right">Aberturas</th>
                            <th class="py-3 px-4 font-semibold text-right">Entregues</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#2a2a2a] text-gray-300">
                        <tr class="hover:bg-[#252525] transition-colors">
                            <td class="py-3 px-4 font-medium text-blue-400">Inverno Coleção BiiO</td>
                            <td class="py-3 px-4 font-mono">12,27%</td>
                            <td class="py-3 px-4 text-right font-mono">626</td>
                            <td class="py-3 px-4 text-right font-mono">5.104</td>
                        </tr>
                        <tr class="hover:bg-[#252525] transition-colors">
                            <td class="py-3 px-4 font-medium text-blue-400">Adeus, jalecos sem graça</td>
                            <td class="py-3 px-4 font-mono">13,29%</td>
                            <td class="py-3 px-4 text-right font-mono">688</td>
                            <td class="py-3 px-4 text-right font-mono">5.177</td>
                        </tr>
                        <tr class="hover:bg-[#252525] transition-colors">
                            <td class="py-3 px-4 font-medium text-blue-400">BiiO Corporate</td>
                            <td class="py-3 px-4 font-mono">12,40%</td>
                            <td class="py-3 px-4 text-right font-mono">651</td>
                            <td class="py-3 px-4 text-right font-mono">5.255</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        const ctx = document.getElementById('notionChart').getContext('2d');
        const labels = Array.from({length: 30}, (_, i) => `${i + 1} Mai`);
        const dataVisitas = [
            45, 60, 55, 110, 540, 210, 70, 65, 80, 95, 85, 140, 390, 580, 180, 
            75, 80, 90, 95, 115, 130, 490, 220, 90, 100, 120, 110, 520, 160, 130
        ];

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Visitas Diárias',
                    data: dataVisitas,
                    borderColor: '#3b82f6', /* Azul elétrico idêntico ao original */
                    backgroundColor: 'rgba(59, 130, 246, 0.05)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3,
                    pointRadius: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { 
                        grid: { color: '#2a2a2a' },
                        ticks: { color: '#888', font: { size: 10 } }
                    },
                    x: { 
                        grid: { display: false },
                        ticks: { color: '#888', font: { size: 9 } }
                    }
                }
            }
        });
    </script>
</body>
</html>
