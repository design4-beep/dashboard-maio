<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard de Performance - Maio 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #191919; /* Cor idêntica ao fundo Dark do Notion */
        }
        .card-notion {
            background-color: #202020;
            border: 1px solid #2a2a2a;
        }
    </style>
</head>
<body class="p-4 md:p-6 text-[#FFFFFFDE]">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-[#2a2a2a] pb-4">
            <div>
                <h1 class="text-lg font-bold text-white tracking-tight">Painel de Performance Comercial &amp; Tráfego</h1>
                <p class="text-xs text-gray-400 mt-0.5">Dados consolidados integrados: Google Analytics, Meta Ads e Instagram</p>
            </div>
            <div class="mt-2 sm:mt-0 flex items-center gap-2">
                <span class="bg-[#2a2a2a] text-gray-300 text-[10px] font-medium px-2 py-1 rounded border border-[#3a3a3a]">01/05/2026 - 31/05/2026</span>
                <span class="bg-emerald-950 text-emerald-400 text-[10px] font-mono px-2 py-1 rounded border border-emerald-900">LIVE</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="card-notion p-4 rounded-xl shadow-md">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Sessões Totais (GA)</p>
                <p class="text-2xl font-bold mt-1 text-white font-mono">4.772</p>
                <p class="text-[10px] text-gray-500 mt-1.5">Duração média: <span class="text-gray-300 font-mono">103s</span></p>
            </div>
            <div class="card-notion p-4 rounded-xl shadow-md">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Visualizações (Insta)</p>
                <p class="text-2xl font-bold mt-1 text-blue-400 font-mono">57,1 mil</p>
                <p class="text-[10px] text-emerald-400 mt-1.5">↑ +43,3% vs mês anterior</p>
            </div>
            <div class="card-notion p-4 rounded-xl shadow-md">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Alcance da Marca</p>
                <p class="text-2xl font-bold mt-1 text-purple-400 font-mono">25,5 mil</p>
                <p class="text-[10px] text-emerald-400 mt-1.5">↑ +106,6% de expansão</p>
            </div>
            <div class="card-notion p-4 rounded-xl shadow-md">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Cliques em Ligações</p>
                <p class="text-2xl font-bold mt-1 text-white font-mono">2,4 mil</p>
                <p class="text-[10px] text-emerald-400 mt-1.5">↑ +213,1% de conversão</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="card-notion p-5 rounded-xl shadow-md lg:col-span-2">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-4">Evolução de Sessões Diárias (Tráfego GA)</h3>
                <div class="h-56">
                    <canvas id="sessionsChart"></canvas>
                </div>
            </div>

            <div class="card-notion p-5 rounded-xl shadow-md flex flex-col justify-between">
                <div>
                    <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-3">Sessões por Dispositivo</h3>
                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between p-2 bg-[#191919] rounded border border-[#2a2a2a]">
                            <span class="text-blue-400">● Mobile</span>
                            <span class="font-mono text-gray-300">72,72% (3.470)</span>
                        </div>
                        <div class="flex justify-between p-2 bg-[#191919] rounded border border-[#2a2a2a]">
                            <span class="text-purple-400">● Desktop</span>
                            <span class="font-mono text-gray-300">26,84% (1.281)</span>
                        </div>
                        <div class="flex justify-between p-2 bg-[#191919] rounded border border-[#2a2a2a]">
                            <span class="text-gray-500">● Tablet</span>
                            <span class="font-mono text-gray-300">0,44% (21)</span>
                        </div>
                    </div>
                </div>
                <div class="pt-3 border-t border-[#2a2a2a] mt-4">
                    <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider mb-2">Interações Consolidadas</p>
                    <div class="grid grid-cols-2 gap-2 text-center text-xs">
                        <div class="p-2 bg-[#191919] rounded border border-[#2a2a2a]">
                            <p class="text-gray-400 text-[10px]">Interações</p>
                            <p class="font-bold text-white font-mono mt-0.5">383</p>
                        </div>
                        <div class="p-2 bg-[#191919] rounded border border-[#2a2a2a]">
                            <p class="text-gray-400 text-[10px]">Seguidores</p>
                            <p class="font-bold text-emerald-400 font-mono mt-0.5">1.488</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card-notion p-5 rounded-xl shadow-md">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Performance de Anúncios (Meta Ads)</h3>
                    <span class="text-[9px] bg-emerald-950 text-emerald-400 font-bold px-1.5 py-0.5 rounded border border-emerald-900">ATIVO</span>
                </div>
                <div class="p-3 bg-[#191919] rounded-lg border border-[#2a2a2a] space-y-2 text-xs">
                    <div class="flex justify-between">
                        <span class="text-gray-400">Anúncio:</span>
                        <span class="font-semibold text-white">SCRUB MASCULINO</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Visualizações no criativo:</span>
                        <span class="font-mono text-white">3,6 mil</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Cliques no Link:</span>
                        <span class="font-mono text-blue-400 font-bold">86</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Taxa de Cliques (CTR):</span>
                        <span class="font-mono text-emerald-400 font-bold">2,37%</span>
                    </div>
                </div>
                <p class="text-[10px] text-gray-500 mt-2.5">• Distribuição do Público do Anúncio: 63% Homens | 36,8% Mulheres (Foco em São Paulo e Minas Gerais).</p>
            </div>

            <div class="card-notion p-5 rounded-xl shadow-md">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-3">Páginas Mais Populares (Acessos)</h3>
                <div class="space-y-2 text-[11px]">
                    <div class="flex justify-between items-center py-1.5 border-b border-[#2a2a2a]">
                        <span class="text-gray-300 truncate max-w-xs">/ (Home da Loja)</span>
                        <span class="font-mono text-gray-400 bg-[#191919] px-2 py-0.5 rounded">1.863</span>
                    </div>
                    <div class="flex justify-between items-center py-1.5 border-b border-[#2a2a2a]">
                        <span class="text-gray-400 truncate max-w-xs">/feminino/scrub-harmonia-decote-canoa...</span>
                        <span class="font-mono text-gray-400 bg-[#191919] px-2 py-0.5 rounded">444</span>
                    </div>
                    <div class="flex justify-between items-center py-1.5 border-b border-[#2a2a2a]">
                        <span class="text-gray-400 truncate max-w-xs">/scrubs/scrub-bem-estar-decote-v-com-bolsos</span>
                        <span class="font-mono text-gray-400 bg-[#191919] px-2 py-0.5 rounded">307</span>
                    </div>
                    <div class="flex justify-between items-center py-1.5">
                        <span class="text-gray-400 truncate max-w-xs">/jalecos/8003-blusa-masculina-padrao-biio</span>
                        <span class="font-mono text-gray-400 bg-[#191919] px-2 py-0.5 rounded">242</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-notion p-5 rounded-xl shadow-md">
            <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-3">Dados Demográficos de Seguidores</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                <div class="p-3 bg-[#191919] rounded border border-[#2a2a2a]">
                    <p class="text-gray-400">Gênero Predominante</p>
                    <p class="text-sm font-bold text-white mt-1">Mulheres (74,7%) <span class="text-gray-500 font-normal">| Homens (25,3%)</span></p>
                </div>
                <div class="p-3 bg-[#191919] rounded border border-[#2a2a2a]">
                    <p class="text-gray-400">Faixa Etária Principal</p>
                    <p class="text-sm font-bold text-purple-400 mt-1">45 - 54 anos</p>
                </div>
                <div class="p-3 bg-[#191919] rounded border border-[#2a2a2a]">
                    <p class="text-gray-400">Localização Top 1</p>
                    <p class="text-sm font-bold text-white mt-1">Belo Horizonte, MG <span class="text-gray-500 font-normal">(9,2%)</span></p>
                </div>
            </div>
        </div>

    </div>

    <script>
        const ctx = document.getElementById('sessionsChart').getContext('2d');
        const labels = ['11 Mai', '14 Mai', '17 Mai', '20 Mai', '23 Mai', '26 Mai', '29 Mai', '01 Jun'];
        
        // Simulação precisa dos picos reais documentados no Analytics (Maio)
        const dadosSessoes = [40, 560, 110, 150, 380, 130, 420, 150];

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Sessões',
                    data: dadosSessoes,
                    borderColor: '#3b82f6', /* Azul elétrico Meta/GA */
                    backgroundColor: 'rgba(59, 130, 246, 0.05)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3,
                    pointRadius: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { 
                        grid: { color: '#2a2a2a' },
                        ticks: { color: '#888', font: { size: 10 } }
                    },
                    x: { 
                        grid: { display: false },
                        ticks: { color: '#888', font: { size: 10 } }
                    }
                }
            }
        });
    </script>
</body>
</html>
