<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Performance</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #191919 !important; /* Cor exata do Notion Dark */
            color: #FFFFFFDE;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .notion-box {
            background-color: #202020;
            border: 1px solid #2a2a2a;
        }
    </style>
</head>
<body class="p-4 min-h-screen">

    <div class="max-w-6xl mx-auto space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-[#2a2a2a] pb-4">
            <div>
                <h1 class="text-lg font-bold text-white">Dashboard de Performance Comercial</h1>
                <p class="text-xs text-gray-400">Dados consolidados e integrados comercialmente</p>
            </div>
            <div class="mt-2 sm:mt-0">
                <span class="bg-[#2a2a2a] text-gray-300 text-[10px] font-medium px-2 py-1 rounded border border-[#3a3a3a]">Maio 2026</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="notion-box p-4 rounded-xl">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Vendas Realizadas (R$)</p>
                <p class="text-xl font-bold mt-1 text-white font-mono">R$ 51.520,00</p>
            </div>
            <div class="notion-box p-4 rounded-xl">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Vendas Realizadas (Un.)</p>
                <p class="text-xl font-bold mt-1 text-blue-400 font-mono">67 pedidos</p>
            </div>
            <div class="notion-box p-4 rounded-xl">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Sessões Totais (GA)</p>
                <p class="text-xl font-bold mt-1 text-purple-400 font-mono">4.772</p>
            </div>
            <div class="notion-box p-4 rounded-xl">
                <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Conversão da Loja</p>
                <p class="text-xl font-bold mt-1 text-emerald-400 font-mono">1,57%</p>
            </div>
        </div>

        <div class="notion-box p-4 rounded-xl">
            <h2 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-3">Etapas do Funil</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <div class="bg-[#191919] p-3 rounded border border-[#2a2a2a] text-center">
                    <p class="text-[10px] text-gray-400 uppercase">Visitantes</p>
                    <p class="text-base font-bold text-white font-mono mt-0.5">3.537</p>
                </div>
                <div class="bg-[#191919] p-3 rounded border border-[#2a2a2a] text-center">
                    <p class="text-[10px] text-blue-400 uppercase">Leads</p>
                    <p class="text-base font-bold text-blue-400 font-mono mt-0.5">23</p>
                </div>
                <div class="bg-[#191919] p-3 rounded border border-[#2a2a2a] text-center">
                    <p class="text-[10px] text-amber-400 uppercase">Oportunidades</p>
                    <p class="text-base font-bold text-amber-400 font-mono mt-0.5">3</p>
                </div>
                <div class="bg-[#191919] p-3 rounded border border-[#2a2a2a] text-center">
                    <p class="text-[10px] text-emerald-400 uppercase">Vendas</p>
                    <p class="text-base font-bold text-emerald-400 font-mono mt-0.5">3</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="notion-box p-4 rounded-xl lg:col-span-2">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-3">Evolução do Tráfego</h3>
                <div class="h-44 w-full">
                    <canvas id="notionChartCanvas"></canvas>
                </div>
            </div>
            <div class="notion-box p-4 rounded-xl">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-3">Produtos Mais Vistos</h3>
                <div class="space-y-2 text-xs">
                    <div class="p-2 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between">
                        <span>Scrub Fem. Harmonia</span>
                        <span class="font-bold text-gray-400">198</span>
                    </div>
                    <div class="p-2 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between">
                        <span>Scrub Masc. Bem-Estar</span>
                        <span class="font-bold text-gray-400">137</span>
                    </div>
                    <div class="p-2 bg-[#191919] rounded border border-[#2a2a2a] flex justify-between">
                        <span>Scrub Fem. Bem-Estar</span>
                        <span class="font-bold text-gray-400">125</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="notion-box p-4 rounded-xl">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Performance Meta Ads</h3>
                <div class="p-3 bg-[#191919] rounded border border-[#2a2a2a] text-xs space-y-1.5">
                    <p><span class="text-gray-400">Criativo:</span> <span class="text-white font-medium">SCRUB MASCULINO</span></p>
                    <p><span class="text-gray-400">Cliques no Link:</span> <span class="text-blue-400 font-mono font-bold">86</span></p>
                    <p><span class="text-gray-400">Taxa (CTR):</span> <span class="text-emerald-400 font-mono font-bold">2,37%</span></p>
                </div>
            </div>
            <div class="notion-box p-4 rounded-xl">
                <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Público Alvo (Instagram)</h3>
                <div class="p-3 bg-[#191919] rounded border border-[#2a2a2a] text-xs space-y-1.5">
                    <p><span class="text-gray-400">Gênero:</span> <span class="text-white font-medium">74,7% Mulheres</span></p>
                    <p><span class="text-gray-400">Idade Principal:</span> <span class="text-purple-400 font-medium">45 - 54 anos</span></p>
                    <p><span class="text-gray-400">Alcance Geral:</span> <span class="text-white font-mono">57,1 mil</span></p>
                </div>
            </div>
        </div>

    </div>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('notionChartCanvas').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['11 Mai', '14 Mai', '17 Mai', '20 Mai', '23 Mai', '26 Mai', '29 Mai', '01 Jun'],
                    datasets: [{
                        data: [40, 560, 110, 150, 380, 130, 420, 150],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.03)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.2,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: '#2a2a2a' }, ticks: { color: '#777', font: { size: 9 } } },
                        x: { grid: { display: false }, ticks: { color: '#777', font: { size: 9 } } }
                    }
                }
            });
        });
    </script>
</body>
</html>
