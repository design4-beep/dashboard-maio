                    </div>
                    <div class="py-3 flex justify-between items-center">
                        <div>
                            <p class="font-medium text-slate-800">JALECO FEMININO PRIME CLÁSSICO - BRANCO</p>
                            <p class="text-xs text-slate-400">Estoque: 18</p>
                        </div>
                        <span class="font-bold text-emerald-600 text-right">R$ 344,50 <br><span class="text-xs text-slate-500 font-normal">1 un.</span></span>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div>
                    <h3 class="text-md font-bold text-slate-900 mb-3">Status de Pagamento (Loja Virtual)</h3>
                    <div class="flex items-center justify-center gap-8 py-2">
                        <div class="text-center">
                            <p class="text-xs text-slate-400 font-medium uppercase">Pago</p>
                            <p class="text-lg font-bold text-emerald-600">R$ 760,40</p>
                        </div>
                        <div class="w-px bg-slate-200 h-10"></div>
                        <div class="text-center">
                            <p class="text-xs text-slate-400 font-medium uppercase">Pendente</p>
                            <p class="text-lg font-bold text-amber-500">R$ 0,00</p>
                        </div>
                    </div>
                    <div class="w-full bg-emerald-100 h-2 rounded-full mt-2"><div class="bg-emerald-500 h-2 rounded-full w-full"></div></div>
                </div>
                <div class="pt-4 border-t border-slate-100 mt-4 text-xs text-slate-500 space-y-1">
                    <p>• <strong>Status dos Pedidos:</strong> Cancelado (33,33%), Enviado (33,33%), Finalizado (33,33% pieces)</p>
                    <p>• <strong>Conversão Geral no Funil RD:</strong> 100% das Oportunidades convertidas em vendas de e-mail.</p>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="text-md font-bold text-slate-900 mb-4">Métricas Consolidadas de Campanhas de E-mail</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-400 uppercase text-[11px] tracking-wider border-b border-slate-200">
                            <th class="py-3 px-4 font-semibold">Nome da Campanha</th>
                            <th class="py-3 px-4 font-semibold">Data do Envio</th>
                            <th class="py-3 px-4 font-semibold text-right">Volume</th>
                            <th class="py-3 px-4 font-semibold text-right">Abertura</th>
                            <th class="py-3 px-4 font-semibold text-right">Cliques (CTOR)</th>
                            <th class="py-3 px-4 font-semibold text-right">Descadastros</th>
                            <th class="py-3 px-4 font-semibold text-right">Spam</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        <tr>
                            <td class="py-3 px-4 text-indigo-600 font-semibold">Inverno Coleção BiiO</td>
                            <td class="py-3 px-4 text-slate-500 font-normal">29/05/2026 17:04</td>
                            <td class="py-3 px-4 text-right">5.104</td>
                            <td class="py-3 px-4 text-right">12,27%</td>
                            <td class="py-3 px-4 text-right text-emerald-600">0,18%</td>
                            <td class="py-3 px-4 text-right text-rose-500">0,33%</td>
                            <td class="py-3 px-4 text-right">0,12%</td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4 text-indigo-600 font-semibold">Adeus, jalecos sem graça</td>
                            <td class="py-3 px-4 text-slate-500 font-normal">22/05/2026 09:00</td>
                            <td class="py-3 px-4 text-right">5.177</td>
                            <td class="py-3 px-4 text-right">13,29%</td>
                            <td class="py-3 px-4 text-right text-emerald-600">0,55%</td>
                            <td class="py-3 px-4 text-right text-rose-500">0,85%</td>
                            <td class="py-3 px-4 text-right">0,16%</td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4 text-indigo-600 font-semibold">BiiO Corporate</td>
                            <td class="py-3 px-4 text-slate-500 font-normal">14/05/2026 08:00</td>
                            <td class="py-3 px-4 text-right">5.255</td>
                            <td class="py-3 px-4 text-right">12,40%</td>
                            <td class="py-3 px-4 text-right text-emerald-600">0,65%</td>
                            <td class="py-3 px-4 text-right text-rose-500">0,74%</td>
                            <td class="py-3 px-4 text-right">0,10%</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="text-md font-bold text-slate-900 mb-4">Evolução do Tráfego da Loja Virtual</h3>
            <div class="h-64">
                <canvas id="consolidatedChart"></canvas>
            </div>
        </div>

    </div>

    <script>
        const ctx = document.getElementById('consolidatedChart').getContext('2d');
        const labels = Array.from({length: 31}, (_, i) => `${String(i + 1).padStart(2, '0')}/05`);
        const visitas = [
            40, 50, 75, 120, 560, 180, 50, 45, 60, 90, 80, 150, 400, 590, 190, 
            65, 70, 85, 90, 110, 140, 510, 200, 85, 95, 115, 105, 530, 150, 140, 120
        ];

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Visitas Diárias',
                    data: visitas,
                    borderColor: '#4f46e5',
                    backgroundColor: 'rgba(79, 70, 229, 0.05)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: true, position: 'bottom' } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
</body>
</html>
