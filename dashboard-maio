                    <span class="absolute -left-3 top-1/2 -translate-y-1/2 bg-slate-900 text-white text-[10px] font-bold px-1 py-0.5 rounded hidden lg:block">100%</span>
                    <p class="text-xs font-semibold text-slate-400 tracking-wider uppercase">Vendas</p>
                    <p class="text-xl font-bold text-slate-800 mt-1">3</p>
                    <p class="text-xs text-rose-600 mt-1">↓ -78,57% (-11)</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <h3 class="text-md font-bold text-slate-900 mb-3">Mais Vendidos (Faturamento Direto)</h3>
                <div class="divide-y divide-slate-100 text-sm">
                    <div class="py-3 flex justify-between items-center">
                        <div>
                            <p class="font-medium text-slate-800">JALECO MASCULINO PRIME CLÁSSICO - BRANCO</p>
                            <p class="text-xs text-slate-400">Estoque: 15</p>
                        </div>
